{
  "name": "crabbuild-compass-vscode",
  "displayName": "Compass Codegraph",
  "description": "Explore, query, and understand how your codebase evolves with Compass.",
  "publisher": "crabbuild",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crabbuild/compass.git"
  },
  "homepage": "https://github.com/crabbuild/compass/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/crabbuild/compass/issues"
  },
  "keywords": [
    "code graph",
    "call graph",
    "architecture",
    "codebase",
    "history"
  ],
  "galleryBanner": {
    "color": "#152238",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "compass.initialize",
        "title": "Compass: Initialize Repository",
        "icon": "$(rocket)"
      },
      {
        "command": "compass.update",
        "title": "Compass: Update Graph",
        "icon": "$(sync)"
      },
      {
        "command": "compass.refreshWorkspace",
        "title": "Compass: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "compass.toggleWatch",
        "title": "Compass: Start or Stop Watch",
        "icon": "$(eye)"
      },
      {
        "command": "compass.startWatch",
        "title": "Compass: Watch for Changes",
        "icon": "$(eye)"
      },
      {
        "command": "compass.stopWatch",
        "title": "Compass: Stop Watching",
        "icon": "$(debug-stop)"
      },
      {
        "command": "compass.openSettings",
        "title": "Compass: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "compass.openGraph",
        "title": "Compass: Open Code Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "compass.openCallGraphGuide",
        "title": "Compass: Call Graph Guide",
        "icon": "$(book)"
      },
      {
        "command": "compass.openCallers",
        "title": "Compass: Show Callers",
        "icon": "$(references)"
      },
      {
        "command": "compass.openCallees",
        "title": "Compass: Show Callees",
        "icon": "$(references)"
      },
      {
        "command": "compass.openCallersAndCallees",
        "title": "Compass: Show Callers & Callees",
        "icon": "$(references)"
      },
      {
        "command": "compass.openArchitecture",
        "title": "Compass: Open Architecture Flow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "compass.openQuery",
        "title": "Compass: Query Codebase",
        "icon": "$(search)"
      },
      {
        "command": "compass.searchSymbols",
        "title": "Compass: Search Symbols",
        "icon": "$(symbol-method)"
      },
      {
        "command": "compass.showCodeImpact",
        "title": "Compass: Show Change Impact",
        "icon": "$(pulse)"
      },
      {
        "command": "compass.exploreCode",
        "title": "Compass: Explore Related Symbols",
        "icon": "$(files)"
      },
      {
        "command": "compass.showNodeTrail",
        "title": "Compass: Show Node Trail",
        "icon": "$(git-merge)"
      },
      {
        "command": "compass.openHistory",
        "title": "Compass: Open Codebase Evolution",
        "icon": "$(history)"
      },
      {
        "command": "compass.selectCli",
        "title": "Compass: Select CLI Version",
        "icon": "$(terminal)"
      },
      {
        "command": "compass.installCli",
        "title": "Compass: Install CLI",
        "icon": "$(cloud-download)"
      }
    ],
    "submenus": [
      {
        "id": "compass.codeGraph",
        "label": "Compass"
      }
    ],
    "configuration": {
      "title": "Compass",
      "properties": {
        "compass.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the selected Compass CLI. Leave empty to auto-detect Compass on PATH and in common install locations."
        },
        "compass.graphNodeLimit": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum detailed nodes before Compass uses a community overview."
        },
        "compass.watch.debounceSeconds": {
          "type": "number",
          "default": 0.4,
          "minimum": 0.05,
          "maximum": 5,
          "scope": "resource",
          "description": "Seconds Compass waits for file changes to settle before updating the graph."
        },
        "compass.watch.poll": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Force polling when watching for repository changes."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "compass",
          "title": "Compass",
          "icon": "media/compass.svg"
        }
      ]
    },
    "views": {
      "compass": [
        {
          "id": "compass.status",
          "name": "Workspace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "compass.openSettings",
          "when": "view == compass.status",
          "group": "navigation@1"
        },
        {
          "command": "compass.refreshWorkspace",
          "when": "view == compass.status",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "compass.update",
          "when": "view == compass.status && viewItem == compass.repository.ready",
          "group": "inline@1"
        },
        {
          "command": "compass.update",
          "when": "view == compass.status && viewItem == compass.repository.failed",
          "group": "inline@1"
        },
        {
          "command": "compass.update",
          "when": "view == compass.status && viewItem == compass.repository.watching",
          "group": "inline@1"
        },
        {
          "command": "compass.startWatch",
          "when": "view == compass.status && viewItem == compass.repository.ready",
          "group": "inline@2"
        },
        {
          "command": "compass.stopWatch",
          "when": "view == compass.status && viewItem == compass.repository.watching",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "compass.codeGraph",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "compass.codeGraph": [
        {
          "command": "compass.openCallers",
          "group": "1_direction@1"
        },
        {
          "command": "compass.openCallees",
          "group": "1_direction@2"
        },
        {
          "command": "compass.openCallersAndCallees",
          "group": "1_direction@3"
        },
        {
          "command": "compass.showCodeImpact",
          "group": "2_impact@1"
        },
        {
          "command": "compass.exploreCode",
          "group": "3_explore@1"
        },
        {
          "command": "compass.showNodeTrail",
          "group": "3_explore@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "compass.getStarted",
        "title": "Understand a codebase with Compass",
        "description": "Connect the Compass CLI, build a graph, and explore code relationships.",
        "steps": [
          {
            "id": "compass.cli",
            "title": "Install the Compass CLI",
            "description": "Open **Compass: Install CLI** to install Compass in the integrated terminal, or select an existing executable."
          },
          {
            "id": "compass.init",
            "title": "Initialize this repository",
            "description": "Preview repository scope and build the first local graph.",
            "media": { "markdown": "README.md" },
            "completionEvents": ["onCommand:compass.initialize"]
          },
          {
            "id": "compass.explore",
            "title": "Open the code graph",
            "description": "Search, filter, inspect relationships, and jump to source.",
            "media": { "markdown": "README.md" },
            "completionEvents": ["onCommand:compass.openGraph"]
          },
          {
            "id": "compass.calls",
            "title": "Trace calls from the editor",
            "description": "Place the cursor inside a function, right-click, choose **Compass**, then select callers, callees, or both.",
            "media": { "markdown": "README.md" },
            "completionEvents": [
              "onCommand:compass.openCallers",
              "onCommand:compass.openCallees",
              "onCommand:compass.openCallersAndCallees"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && node ./dist/test/runTest.cjs",
    "package": "npm run build && vsce package --no-dependencies",
    "smoke:vsix": "node scripts/smoke-vsix.mjs"
  },
  "dependencies": {
    "@compass/viewer": "0.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.12",
    "mocha": "^11.7.4",
    "vitest": "^3.2.4"
  }
}
