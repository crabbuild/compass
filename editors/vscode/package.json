{
  "name": "compass-vscode",
  "displayName": "Compass",
  "description": "Explore, query, and understand how your codebase evolves with Compass.",
  "publisher": "crabbuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crabbuild/compass.git"
  },
  "homepage": "https://github.com/crabbuild/compass/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/crabbuild/compass/issues"
  },
  "keywords": [
    "code graph",
    "call graph",
    "architecture",
    "codebase",
    "history"
  ],
  "galleryBanner": {
    "color": "#152238",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "compass.initialize",
        "title": "Compass: Initialize Repository",
        "icon": "$(rocket)"
      },
      {
        "command": "compass.update",
        "title": "Compass: Update Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "compass.toggleWatch",
        "title": "Compass: Start or Stop Watch",
        "icon": "$(eye)"
      },
      {
        "command": "compass.openGraph",
        "title": "Compass: Open Code Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "compass.openCallGraph",
        "title": "Compass: Open Call Graph from Cursor",
        "icon": "$(references)"
      },
      {
        "command": "compass.openArchitecture",
        "title": "Compass: Open Architecture Flow",
        "icon": "$(circuit-board)"
      },
      {
        "command": "compass.openQuery",
        "title": "Compass: Query Codebase",
        "icon": "$(search)"
      },
      {
        "command": "compass.openHistory",
        "title": "Compass: Open Codebase Evolution",
        "icon": "$(history)"
      },
      {
        "command": "compass.selectCli",
        "title": "Compass: Select CLI Binary",
        "icon": "$(terminal)"
      }
    ],
    "configuration": {
      "title": "Compass",
      "properties": {
        "compass.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an installed Compass CLI. Leave empty to discover compass on PATH."
        },
        "compass.graphNodeLimit": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum detailed nodes before Compass uses a community overview."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "compass",
          "title": "Compass",
          "icon": "media/compass.svg"
        }
      ]
    },
    "views": {
      "compass": [
        {
          "id": "compass.status",
          "name": "Repository"
        },
        {
          "id": "compass.operations",
          "name": "Operations"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "compass.update",
          "when": "view == compass.status",
          "group": "navigation"
        },
        {
          "command": "compass.openGraph",
          "when": "view == compass.status",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "compass.openCallGraph",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "compass.getStarted",
        "title": "Understand a codebase with Compass",
        "description": "Connect the Compass CLI, build a graph, and explore code relationships.",
        "steps": [
          {
            "id": "compass.cli",
            "title": "Connect the Compass CLI",
            "description": "Install Compass separately and configure `compass.cliPath` if it is not on PATH."
          },
          {
            "id": "compass.init",
            "title": "Initialize this repository",
            "description": "Preview repository scope and build the first local graph.",
            "media": { "markdown": "README.md" },
            "completionEvents": ["onCommand:compass.initialize"]
          },
          {
            "id": "compass.explore",
            "title": "Open the code graph",
            "description": "Search, filter, inspect relationships, and jump to source.",
            "media": { "markdown": "README.md" },
            "completionEvents": ["onCommand:compass.openGraph"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && node ./dist/test/runTest.cjs",
    "package": "npm run build && vsce package --no-dependencies",
    "smoke:vsix": "node scripts/smoke-vsix.mjs"
  },
  "dependencies": {
    "@compass/viewer": "0.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.12",
    "mocha": "^11.7.4",
    "vitest": "^3.2.4"
  }
}
